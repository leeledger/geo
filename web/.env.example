# ── 데이터베이스 ──────────────────────────────────────────────
# Postgres 면 어디든 된다. 없으면 .data/*.jsonl 파일 폴백 (개발 전용).
#
# 기존 Supabase 프로젝트 재사용:
#   Supabase → Settings → Database → Connection string → "Transaction pooler" (포트 6543)
#   ※ 서버리스에서는 반드시 Pooler 를 쓸 것. Direct(5432) 는 커넥션이 금방 고갈된다.
# Neon:            Dashboard → Connection string (pooled)
# Vercel Postgres: 연동 시 POSTGRES_URL 이 자동 주입되므로 그 값을 넣으면 된다
DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require

# IP 해시 솔트 — 배포 시 임의 문자열로 교체
IP_HASH_SALT=change-me

# 관리자 화면 접근 토큰 (/admin?key=... )
ADMIN_TOKEN=change-me-too

# 문의 수신 메일
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.co.kr
