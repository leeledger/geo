# 의존성 · 빌드
node_modules/
.next/
out/
dist/

# 환경변수 — service_role 키가 유출되면 DB 전체가 열린다
.env
.env.*
!.env.example

# 로컬 데이터 폴백 (개발용)
.data/

# OS · 편집기
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Next
next-env.d.ts
*.tsbuildinfo

# 스크래치
/tmp/
*.log

# Vercel
.vercel

# 리드 백업 — 사람 연락처가 들어갈 수 있다. 저장소에 두지 않는다
scratch-leads-backup.json

# 브라우저 세션 — 사람이 직접 로그인한 네이버·구글 쿠키가 들어 있다 (18MB).
# 올라가면 계정이 통째로 열린다. open-session.mjs 가 만든다
.browser-profile/
# 고객 블로그용 따로 둔 프로필(open-session.mjs --blog, Step 35 D55)
.browser-profile-*/

# 도구가 저장소 루트에 남기는 화면 캡처
/*-look.png

# 디자인 캔버스 조립본 (2MB, 작업 파일에서 다시 만든다)
design/**/*-page.html
tools/heartbeat.log
tools/.ai-web-measure.lock

# PC 일꾼 상태·잠금 (tools/pc-runner.mjs)
tools/.pc-runner-state.json
tools/.pc-runner.lock

# 파일럿 보고서·손 확인 캡처 — 고객 이름과 측정 원문이 들어간다. 저장소에 두지 않는다 (academy/scripts/pilot-report.mjs)
deliverables/*/pilot-reports/
