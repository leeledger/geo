  "prompts": [
    {
      "id": "p01",
      "stage": "problem",
      "text": "엑셀로 재고관리 하는데 이제 한계가 온 것 같아. 뭘 도입해야 할까?"
    },
    {
      "id": "p02",
      "stage": "problem",
      "text": "직원 30명 회사인데 회계랑 재고가 따로 놀아서 매번 이중으로 입력해. 어떻게 해결해?"
    },
    {
      "id": "p03",
      "stage": "problem",
      "text": "중소기업인데 전사 데이터가 부서마다 흩어져 있어. 해결책이 뭐가 있을까?"
    },
    {
      "id": "p04",
      "stage": "problem",
      "text": "수기로 발주서 관리하는 거 그만하고 싶은데 방법 없을까?"
    },
    {
      "id": "p05",
      "stage": "problem",
      "text": "매출 마감이 매달 일주일씩 걸리는데 이게 정상이야?"
    },
    {
      "id": "p06",
      "stage": "problem",
      "text": "제조업 소기업인데 원가 계산이 자꾸 안 맞아. 어떻게 해야 해?"
    },
    {
      "id": "p07",
      "stage": "problem",
      "text": "회사가 커지는데 관리 시스템이 하나도 없어. 뭐부터 해야 하나?"
    },
    {
      "id": "p08",
      "stage": "problem",
      "text": "세금계산서랑 재고가 연동이 안 돼서 업무가 두 배야. 개선 방법 알려줘"
    },
    {
      "id": "p09",
      "stage": "problem",
      "text": "중소기업 디지털 전환 뭐부터 시작하는 게 맞아?"
    },
    {
      "id": "p10",
      "stage": "problem",
      "text": "그룹웨어랑 ERP 중에 뭘 먼저 도입하는 게 나아?"
    },
    {
      "id": "p11",
      "stage": "discovery",
      "text": "중소기업용 ERP 추천해줘"
    },
    {
      "id": "p12",
      "stage": "discovery",
      "text": "국내 ERP 솔루션 어떤 게 있어?"
    },
    {
      "id": "p13",
      "stage": "discovery",
      "text": "50인 미만 회사에 맞는 ERP 뭐가 좋아?"
    },
    {
      "id": "p14",
      "stage": "discovery",
      "text": "클라우드 ERP 국내 업체 좀 알려줘"
    },
    {
      "id": "p15",
      "stage": "discovery",
      "text": "제조업 중소기업에 맞는 ERP 추천"
    },
    {
      "id": "p16",
      "stage": "discovery",
      "text": "유통업체가 쓰기 좋은 ERP 뭐가 있어?"
    },
    {
      "id": "p17",
      "stage": "discovery",
      "text": "저렴한 ERP 프로그램 추천해줘"
    },
    {
      "id": "p18",
      "stage": "discovery",
      "text": "스타트업이 쓸만한 ERP 있을까?"
    },
    {
      "id": "p19",
      "stage": "discovery",
      "text": "국산 ERP랑 외산 ERP 중에 어떤 걸 써야 해?"
    },
    {
      "id": "p20",
      "stage": "discovery",
      "text": "중소기업 회계 프로그램 추천해줘"
    },
    {
      "id": "p21",
      "stage": "discovery",
      "text": "재고관리 되는 ERP 추천해줘"
    },
    {
      "id": "p22",
      "stage": "discovery",
      "text": "SaaS형 ERP 국내 서비스 목록 정리해줘"
    },
    {
      "id": "p23",
      "stage": "comparison",
      "text": "더존이랑 이카운트 중에 뭐가 더 나아?"
    },
    {
      "id": "p24",
      "stage": "comparison",
      "text": "이카운트랑 SAP Business One 비교해줘"
    },
    {
      "id": "p25",
      "stage": "comparison",
      "text": "더존 ERP랑 영림원 차이가 뭐야?"
    },
    {
      "id": "p26",
      "stage": "comparison",
      "text": "국내 ERP 업체 비교표 좀 만들어줘"
    },
    {
      "id": "p27",
      "stage": "comparison",
      "text": "이카운트랑 얼마에요 중에 뭘 골라야 해?"
    },
    {
      "id": "p28",
      "stage": "comparison",
      "text": "SAP Business One이랑 오라클 넷스위트 중에 중소기업엔 뭐가 나아?"
    },
    {
      "id": "p29",
      "stage": "comparison",
      "text": "더존 아마란스랑 아이큐브 차이가 뭐야?"
    },
    {
      "id": "p30",
      "stage": "comparison",
      "text": "중소기업 ERP 세 개만 골라서 비교해줘"
    },
    {
      "id": "p31",
      "stage": "comparison",
      "text": "이카운트 단점이 뭐야?"
    },
    {
      "id": "p32",
      "stage": "comparison",
      "text": "더존 ERP 실제 후기 어때?"
    },
    {
      "id": "p33",
      "stage": "intent",
      "text": "월 10만원대로 쓸 수 있는 ERP 있어?"
    },
    {
      "id": "p34",
      "stage": "intent",
      "text": "중소기업 ERP 도입 비용 얼마나 들어?"
    },
    {
      "id": "p35",
      "stage": "intent",
      "text": "ERP 도입할 때 받을 수 있는 정부 지원사업 있어?"
    },
    {
      "id": "p36",
      "stage": "intent",
      "text": "직원 30명 회사면 ERP 견적이 대략 얼마 나와?"
    },
    {
      "id": "p37",
      "stage": "intent",
      "text": "ERP 무료로 체험해볼 수 있는 곳 있어?"
    },
    {
      "id": "p38",
      "stage": "intent",
      "text": "ERP 도입하는 데 기간이 얼마나 걸려?"
    },
    {
      "id": "p39",
      "stage": "intent",
      "text": "ERP 구축형이랑 구독형 중에 뭐가 나아?"
    },
    {
      "id": "p40",
      "stage": "intent",
      "text": "ERP 업체 선정할 때 뭘 봐야 해?"
    },
    {
      "id": "p41",
      "stage": "intent",
      "text": "이카운트 가격 얼마야?"
    },
    {
      "id": "p42",
      "stage": "intent",
      "text": "더존 ERP 견적은 어떻게 받아?"
    },
    {
      "id": "p43",
      "stage": "brand",
      "text": "이카운트 어때? 쓸만해?"
    },
    {
      "id": "p44",
      "stage": "brand",
      "text": "더존비즈온 믿을만한 회사야?"
    },
    {
      "id": "p45",
      "stage": "brand",
      "text": "영림원소프트랩은 어떤 회사야?"
    },
    {
      "id": "p46",
      "stage": "brand",
      "text": "이카운트 써본 사람들 평가가 어때?"
    },
    {
      "id": "p47",
      "stage": "brand",
      "text": "더존 ERP 장단점 알려줘"
    },
    {
      "id": "p48",
      "stage": "brand",
      "text": "아이퀘스트 얼마에요 괜찮아?"
    },
    {
      "id": "p49",
      "stage": "brand",
      "text": "뉴젠솔루션 ERP 어때?"
    },
    {
      "id": "p50",
      "stage": "brand",
      "text": "SAP Business One 한국에서 많이 쓰는 편이야?"
    }
  ]
